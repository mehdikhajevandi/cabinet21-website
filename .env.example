# ------------------------------------------------------------------
# Cabinet21 — copy this file to ".env" and change the values.
# (.env is ignored by git, so your password stays private.)
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Contact form → e-mail
# ------------------------------------------------------------------
# Main channel: FormSubmit. The destination inbox is written in the URL,
# so messages can only land in that mailbox. Built-in default:
# mehdi.khajevandi.21@gmail.com
#
# After confirming the address once, FormSubmit shows a random alias
# (e.g. "el/1a2b3c4d"). Put it here to keep the address out of the code:
# VITE_FORM_SUBMIT_TARGET=el/1a2b3c4d

# Optional second channel: Web3Forms. Only works with a key created for
# YOUR inbox (https://web3forms.com — free, no account). Keys are public
# but each key always delivers to the mailbox that created it.
# VITE_WEB3FORMS_ACCESS_KEY=your-own-key

# ------------------------------------------------------------------
# Optional: local message server + admin panel (site/#/admin)
# ------------------------------------------------------------------

# Password of the admin panel  →  site/#/admin
ADMIN_PASSWORD=123456789reza

# Port of the message server
PORT=8787

# Only needed when the website is hosted somewhere else (GitHub Pages,
# Netlify, Vercel) and the server runs on another address. This value is
# read at BUILD time by Vite:
# VITE_API_BASE=https://cabinet21-api.onrender.com
