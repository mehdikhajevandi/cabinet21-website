# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit real keys.

# JSONBin v3 access key (https://jsonbin.io/app/access-keys)
JSONBIN_ACCESS_KEY=your-jsonbin-access-key

# Id of the bin that stores { "messages": [...] }
# Quick start: npm run jsonbin:init  (creates a bin and writes the id here)
JSONBIN_BIN_ID=your-jsonbin-bin-id

# Optional overrides
# PORT=3000
# JSONBIN_API_BASE=https://api.jsonbin.io/v3
